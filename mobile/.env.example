# Copier ce fichier en mobile/.env (jamais versionné) et remplacer l'IP par
# celle, sur le LAN, de la machine qui fait tourner le backend
# (make api-lan + make tiles-serve). Les variables EXPO_PUBLIC_* sont inlinées
# dans le bundle JS : rechargement complet de l'app après modification.
# EXPO_PUBLIC_API_URL sert aussi les glyphes des étiquettes de la carte
# (/fonts) : sans elle, la carte s'affiche colorée mais sans noms de villes.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8200
EXPO_PUBLIC_TILES_URL=http://192.168.1.20:8300
