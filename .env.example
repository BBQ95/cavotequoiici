# Copier en .env et adapter si besoin (le .env n'est jamais versionné).
# Lu par make (syntaxe make, pas dotenv) : doubler les `$` dans les valeurs,
# pas de guillemets autour des valeurs, pas de préfixe `export`.
# URL de connexion à la base (valeur par défaut = conteneur docker-compose de dev).
DATABASE_URL=postgresql+psycopg2://postgres:cavote@localhost:5432/postgres

# Date de référence pour le calcul de récence des scrutins (défaut : date du jour).
# REFERENCE_DATE=2026-06-27
